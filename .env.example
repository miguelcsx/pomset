# Copy to `.env` (ignored by git) and fill in what you need. Every variable is
# optional for the local workbench: `pnpm workbench` runs without any of them.

# --- Public deployment (Render sets the host and PORT itself) -----------------
# Signs session tokens. Required for a public host; at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Hostname the public workbench serves. Render sets RENDER_EXTERNAL_HOSTNAME.
POMSET_WORKBENCH_PUBLIC_HOST=
# Port to listen on. Falls back to PORT, then 8811.
POMSET_WORKBENCH_PORT=8811
# Directory for the workbench records and accounts.sqlite. Defaults to
# .pomset-workbench in the working directory.
POMSET_WORKBENCH_DATA=.pomset-workbench

# --- Demo accounts ------------------------------------------------------------
# Set to 1 to create the demo admin (admin@pomset.example) and demo user
# (user@pomset.example) at start-up. Existing accounts are never changed.
POMSET_DEMO_ACCOUNTS=
# Required when POMSET_DEMO_ACCOUNTS=1. Each needs 8 to 72 bytes.
POMSET_DEMO_ADMIN_PASSWORD=
POMSET_DEMO_USER_PASSWORD=
