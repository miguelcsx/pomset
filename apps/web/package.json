{
  "name": "@pomset/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Next.js client: the editor-first workbench over the three experiences Explore, Validate and Optimize. It renders evidence the API supplies and never analyses, measures or decides eligibility itself.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "POMSET_WEB_EXPORT=1 next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pomset/contracts": "workspace:*",
    "@pomset/ui": "workspace:*",
    "monaco-editor": "0.52.2",
    "next": "16.4.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
